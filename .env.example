# Optional client-side fallback used only for local development.
# Production reads the public phone number from the Worker's WHATSAPP_NUMBER binding.
VITE_WHATSAPP_NUMBER=2348000000000

# Used only by `npm run smoke`; do not add a trailing path.
SMOKE_BASE_URL=https://joygivercollections.com

# ADMIN_SETUP_TOKEN is a Worker secret. Never put a real value in this file.
# Set it with: npx wrangler secret put ADMIN_SETUP_TOKEN
