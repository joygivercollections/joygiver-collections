{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joygiver-collections",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joygiver-store",
      "database_id": "d448a559-e96c-4a1c-98eb-e69ad6f97065"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "joygiver-product-images"
    }
  ],
  "vars": {
    // Public business phone number in international format, digits only (Nigeria example: 2348030000000).
    "WHATSAPP_NUMBER": "2348069010690"
  }
}
