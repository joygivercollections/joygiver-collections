{
  "name": "joygiver-collections",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:dom && npm run test:worker",
    "test:dom": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:worker:watch": "vitest --config vitest.worker.config.ts",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply joygiver-store --local",
    "db:migrate:remote": "wrangler d1 migrations apply joygiver-store --remote",
    "deploy": "npm test && npm run typecheck && npm run build && wrangler deploy",
    "smoke": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "hono": "4.13.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/vitest-plugin": "1.1.13",
    "@cloudflare/workers-types": "5.20260919.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  }
}
